generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  template  String     @default("SIMPLE") // SIMPLE | DETAILED
  sortOrder Int        @default(0)
  name      Json
  products  Product[]
}

model Product {
  id               Int        @id @default(autoincrement())
  slug             String     @unique
  categoryId       Int
  category         Category   @relation(fields: [categoryId], references: [id])
  templateOverride String?
  status           String     @default("DRAFT") // DRAFT | PUBLISHED
  brandId          Int?
  brand            Brand?     @relation(fields: [brandId], references: [id])
  seoTitle         Json?
  seoDescription   Json?
  sourceUrl        String?    @unique
  sourcePriceUsd   Float?
  title            Json
  subtitle         Json
  shortSpec        Json
  descriptionHtml  Json
  sections         Json
  highlights       Json
  inTheBox         Json
  faq              Json
  specs            Json
  images           Json
  badge            String?
  reviewed         Json
  isDemo           Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  variants         Variant[]
  favorites        Favorite[]
}

model Variant {
  id           Int     @id @default(autoincrement())
  productId    Int
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String  @unique
  name         Json
  colorHex     String?
  imageIndex   Int?
  priceUzs     Int
  compareAtUzs Int?
  stock        Int     @default(0)
  sortOrder    Int     @default(0)
}

model SpecLabel {
  key   String @id
  label Json
}

model Order {
  id              Int                @id @default(autoincrement())
  number          Int                @unique
  status          String             @default("NEW") // NEW | CONFIRMED | DELIVERED | CANCELLED
  name            String
  phone           String
  region          String
  address         String
  comment         String?
  locale          String
  totalUzs        Int
  paymentStatus   String             @default("UNPAID")
  paymentProvider String?
  /// Optional delivery pin (Telegram location / geolocation), both or neither.
  lat             Float?
  lng             Float?
  createdAt       DateTime           @default(now())
  lines           OrderLine[]
  events          OrderStatusEvent[]

  @@index([phone])
  @@index([createdAt])
}

model OrderLine {
  id               Int    @id @default(autoincrement())
  orderId          Int
  order            Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId        Int
  sku              String
  productTitle     String
  variantName      String
  priceUzs         Int
  qty              Int
  originalPriceUzs Int?
  discountUzs      Int    @default(0)
  promotionId      Int?
}

model Setting {
  key   String @id
  value String
}

model UiString {
  key   String @id
  value Json
}

model AdminUser {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  name           String
  role           String
  passwordHash   String
  active         Boolean   @default(true)
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userEmail String
  action    String // create | update | delete | status | login
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PageView {
  id           Int      @id @default(autoincrement())
  day          String // YYYY-MM-DD (Asia/Tashkent)
  path         String
  locale       String
  referrerHost String?
  device       String // mobile | tablet | desktop
  visitorHash  String
  signedIn     Boolean? // null = unknown: recorded before the split existed, or the account lookup failed
  region       String? // signed-in visitors only: the customer's profile region code. Never a customer id.
  createdAt    DateTime @default(now())

  @@index([day])
}

model DailyTraffic {
  day      String @id
  views    Int
  visitors Int
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  sortOrder Int       @default(0)
  products  Product[]
}

model Promotion {
  id         Int       @id @default(autoincrement())
  name       String
  kind       String // PERCENT | AMOUNT
  value      Int
  targetType String // PRODUCT | CATEGORY | BRAND
  targetIds  Json
  enabled    Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Customer {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String
  region    String
  notes     String   @default("")
  tags      Json
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Customer account (Telegram sign-in). accountCreatedAt = null -> no account (order-only client).
  telegramUserId   String?           @unique
  telegramChatId   String?
  accountLocale    String?
  notifyTelegram   Boolean           @default(true)
  sessionVersion   Int               @default(0)
  accountCreatedAt DateTime?
  lastLoginAt      DateTime? // latest website sign-in (link or code); a Mini App launch does not count
  lastSeenAt       DateTime? // latest signed-in page view, written at most once per 5 minutes
  addresses        CustomerAddress[]
  favorites        Favorite[]
  logins           CustomerLogin[]
}

/// Website sign-in through the Telegram bot. The raw token and browser secret are never stored, only SHA-256 hashes.
model CustomerLogin {
  id                    Int       @id @default(autoincrement())
  tokenHash             String    @unique
  browserHash           String
  checkCode             String
  status                String    @default("PENDING") // PENDING | CONFIRMED | USED | WRONG_CODE (wrong pick in the bot: cancelled, starts the 60 s cooldown)
  pendingTelegramUserId String? // Telegram user who opened the deep link; binds start -> contact -> confirm
  choices               Json? // 3 shuffled 4-digit codes for the bot buttons (stable per login)
  customerId            Int?
  customer              Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt             DateTime
  createdAt             DateTime  @default(now())

  @@index([pendingTelegramUserId, status])
  @@index([createdAt])
}

/// 6-digit sign-in codes sent through the bot to an already linked chat. Only the SHA-256 hash is stored.
model CustomerLoginCode {
  id        Int       @id @default(autoincrement())
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
}

model CustomerAddress {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  recipient  String
  region     String
  address    String
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Favorite {
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, productId])
  @@index([productId])
}

model OrderStatusEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model BlogPost {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  status         String    @default("DRAFT")
  publishedAt    DateTime?
  title          Json
  excerpt        Json
  contentHtml    Json
  seoTitle       Json
  seoDescription Json
  coverImage     String?
  tags           Json
  reviewed       Json
  authorId       Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, publishedAt])
}

model Banner {
  id             Int       @id @default(autoincrement())
  title          Json // L10n
  text           Json // L10n
  buttonText     Json // L10n
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  active         Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([active, sortOrder])
}
