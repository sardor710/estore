DATABASE_URL=file:./dev.db
# Bootstrap only: signing in with these creates the first full admin when no staff accounts exist.
# Afterwards manage staff in the admin (Users); lost access: npm run admin:reset -- <email>
ADMIN_USER=admin
# REQUIRED for the first login: at least 10 characters. The admin stays locked ("Admin not configured") while empty and no staff account exists.
ADMIN_PASSWORD=
# REQUIRED: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
ANTHROPIC_API_KEY=
SITE_URL=http://localhost:3000

# Set to 1 only when behind a trusted reverse proxy that sets X-Forwarded-For (used for the admin login and order throttles, and to count unique visitors in analytics; the proxy must overwrite X-Forwarded-For)
TRUST_PROXY=

# Optional: folder for uploaded images (default: ./uploads); back it up with the database
UPLOADS_DIR=

# Optional: 1 shows demo products in a production build (hidden there by default)
SHOW_DEMO=

# Optional: Yandex Maps JavaScript API key (used with API 2.1) ("JavaScript API" key at https://developer.tech.yandex.ru).
# Enables "Choose on map" at checkout and in saved addresses. It is sent to browsers, so restrict it by HTTP Referer
# to your domains in the Yandex developer console. Rebuild after changing it (NEXT_PUBLIC_ values are inlined).
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# Optional: Yandex "Geocoder API" key, shows the street address under the map pin (falls back to the key above).
NEXT_PUBLIC_YANDEX_GEOCODER_API_KEY=

# Optional: OpenRouter key for translating the English text inside product images into uz and ru (Images tab).
# Without it product images are shown as they are in every language.
OPENROUTER_API_KEY=
# Optional overrides: image model (default tencent/hy-image-v3.5-preview), text reader (default anthropic/claude-haiku-5.5)
# and the most images redrawn per UTC day (default 300, about $0.024 each; 0 turns the feature off).
OPENROUTER_IMAGE_MODEL=
OPENROUTER_READER_MODEL=
IMAGE_TRANSLATION_DAILY_LIMIT=
