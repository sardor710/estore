DATABASE_URL=file:./dev.db
ADMIN_USER=admin
# REQUIRED: your own admin password, at least 10 characters. The admin stays locked ("Admin not configured") while empty.
ADMIN_PASSWORD=
# REQUIRED: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
ANTHROPIC_API_KEY=
SITE_URL=http://localhost:3000

# Set to 1 only when behind a trusted reverse proxy that sets X-Forwarded-For (used for the admin login and order throttles)
TRUST_PROXY=
