[Unit]
Description=zanko.uz ⇄ ERPNext sync (outbox drain, new SKUs, 5-min reconcile)
After=zanko.service

[Service]
Type=oneshot
User=nick
EnvironmentFile=/home/nick/zanko/.env
ExecStart=/bin/sh -c 'exec /usr/bin/curl -fsS --max-time 290 -X POST -H "Authorization: Bearer $ERP_SYNC_TOKEN" http://127.0.0.1:3100/api/erp/sync'
